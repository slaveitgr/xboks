+/* ExecModelClient's AppInstanceStatics asks the CoreWindow broker for this service. The
+ * measured IUnknown-derived ABI has five methods after IUnknown, not IInspectable slots.
+ * Registration, enumeration and redirection require a cross-process instance registry; do
+ * not report those operations as successful until such a registry exists. */
+struct application_instance_broker;
+struct application_instance_broker_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)(struct application_instance_broker *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(struct application_instance_broker *);
+    ULONG (WINAPI *Release)(struct application_instance_broker *);
+    HRESULT (WINAPI *RegisterInstanceKey)(struct application_instance_broker *, const WCHAR *, DWORD *);
+    HRESULT (WINAPI *Unregister)(struct application_instance_broker *);
+    HRESULT (WINAPI *GetActivatedEventArgs)(struct application_instance_broker *, IUnknown **);
+    HRESULT (WINAPI *RedirectActivationTo)(struct application_instance_broker *, const WCHAR *);
+    HRESULT (WINAPI *GetInstanceKeys)(struct application_instance_broker *, ULONG *, WCHAR ***);
+};
+struct application_instance_broker
+{
+    const struct application_instance_broker_vtbl *vtbl;
+    LONG refcount;
+    IUnknown *ftm;
+};
+
+/* AppInstance.GetActivatedEventArgs describes process startup, so repeated queries must not
+ * change identity or start reading a later inbox activation. wineuwp.dll cannot unload and
+ * retains the single strong reference for this process's lifetime. Construct outside the
+ * lock because creating a protocol Uri can activate another WinRT class. */
+static SRWLOCK initial_activation_lock = SRWLOCK_INIT;
+static IInspectable *initial_activation_args;
+
+static ULONG WINAPI instance_broker_AddRef(struct application_instance_broker *broker)
+{
+    return InterlockedIncrement(&broker->refcount);
+}
+static ULONG WINAPI instance_broker_Release(struct application_instance_broker *broker)
+{
+    ULONG refs = InterlockedDecrement(&broker->refcount);
+    if (!refs)
+    {
+        if (broker->ftm) IUnknown_Release(broker->ftm);
+        free(broker);
+    }
+    return refs;
+}
+static HRESULT WINAPI instance_broker_QueryInterface(struct application_instance_broker *broker,
+        REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!iid) return E_INVALIDARG;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IApplicationInstanceBroker))
+    {
+        *out = broker;
+        instance_broker_AddRef(broker);
+        return S_OK;
+    }
+    if (IsEqualGUID(iid, &IID_IMarshal) || IsEqualGUID(iid, &IID_IAgileObject))
+        return IUnknown_QueryInterface(broker->ftm, iid, out);
+    return E_NOINTERFACE;
+}
+static HRESULT WINAPI instance_broker_RegisterInstanceKey(struct application_instance_broker *broker,
+        const WCHAR *key, DWORD *status)
+{
+    if (!status) return E_POINTER;
+    *status = 0;
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI instance_broker_Unregister(struct application_instance_broker *broker)
+{
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI instance_broker_GetActivatedEventArgs(struct application_instance_broker *broker,
+        IUnknown **out)
+{
+    IInspectable *candidate;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    AcquireSRWLockShared(&initial_activation_lock);
+    if (initial_activation_args)
+    {
+        IInspectable_AddRef(initial_activation_args);
+        *out = (IUnknown *)initial_activation_args;
+        ReleaseSRWLockShared(&initial_activation_lock);
+        return S_OK;
+    }
+    ReleaseSRWLockShared(&initial_activation_lock);
+    if (!(candidate = create_launch_args(L""))) return E_FAIL;
+    AcquireSRWLockExclusive(&initial_activation_lock);
+    if (!initial_activation_args)
+    {
+        initial_activation_args = candidate;
+        candidate = NULL;
+    }
+    IInspectable_AddRef(initial_activation_args);
+    *out = (IUnknown *)initial_activation_args;
+    ReleaseSRWLockExclusive(&initial_activation_lock);
+    if (candidate) IInspectable_Release(candidate);
+    return S_OK;
+}
+static HRESULT WINAPI instance_broker_RedirectActivationTo(struct application_instance_broker *broker,
+        const WCHAR *key)
+{
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI instance_broker_GetInstanceKeys(struct application_instance_broker *broker,
+        ULONG *count, WCHAR ***keys)
+{
+    if (count) *count = 0;
+    if (keys) *keys = NULL;
+    if (!count || !keys) return E_POINTER;
+    return E_NOTIMPL;
+}
+static const struct application_instance_broker_vtbl instance_broker_vtbl =
+{
+    instance_broker_QueryInterface, instance_broker_AddRef, instance_broker_Release,
+    instance_broker_RegisterInstanceKey, instance_broker_Unregister,
+    instance_broker_GetActivatedEventArgs, instance_broker_RedirectActivationTo,
+    instance_broker_GetInstanceKeys
+};
+static HRESULT create_instance_broker(REFIID iid, void **out)
+{
+    struct application_instance_broker *broker;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(broker = calloc(1, sizeof(*broker)))) return E_OUTOFMEMORY;
+    broker->vtbl = &instance_broker_vtbl;
+    broker->refcount = 1;
+    if (SUCCEEDED(hr = CoCreateFreeThreadedMarshaler((IUnknown *)broker, &broker->ftm)))
+        hr = instance_broker_QueryInterface(broker, iid, out);
+    instance_broker_Release(broker);
+    return hr;
+}
