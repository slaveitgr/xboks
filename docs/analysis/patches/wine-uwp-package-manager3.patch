+static HRESULT WINAPI package_manager3_FindPackageVolumes( IPackageManager3 *iface, IIterable_PackageVolume **volumes )
+{
+    PROPVARIANT result;
+    HRESULT hr;
+
+    if (!volumes) return E_POINTER;
+    *volumes = NULL;
+    if (FAILED(hr = get_package_volumes( (IUnknown *)iface, NULL, &result, FALSE ))) return hr;
+    hr = IUnknown_QueryInterface( result.punkVal, &IID_IIterable_PackageVolume, (void **)volumes );
+    IUnknown_Release( result.punkVal );
+    return hr;
+}
+
+static HRESULT WINAPI package_manager3_GetDefaultPackageVolume( IPackageManager3 *iface, IPackageVolume **volume )
+{
+    if (!volume) return E_POINTER;
+    *volume = NULL;
+    return package_volume_create( volume );
+}
+
+static HRESULT WINAPI package_manager3_FindPackageVolumeByName( IPackageManager3 *iface, HSTRING name, IPackageVolume **volume )
+{
+    IPackageVolume *candidate;
+    HSTRING known_name;
+    HRESULT hr;
+
+    if (!volume) return E_POINTER;
+    *volume = NULL;
+    if (!name || !WindowsGetStringLen( name )) return E_INVALIDARG;
+    if (FAILED(hr = package_volume_create( &candidate ))) return hr;
+    if (SUCCEEDED(hr = IPackageVolume_get_Name( candidate, &known_name )))
+    {
+        if (WindowsGetStringLen( name ) == WindowsGetStringLen( known_name ) &&
+            !wcsicmp( WindowsGetStringRawBuffer( name, NULL ), WindowsGetStringRawBuffer( known_name, NULL ) ))
+            *volume = candidate;
+        else hr = E_NOTIMPL; /* Other volumes are not represented by this backend yet. */
+        WindowsDeleteString( known_name );
+    }
+    if (!*volume) IPackageVolume_Release( candidate );
+    return hr;
+}
