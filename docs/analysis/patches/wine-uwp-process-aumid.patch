 /***********************************************************************
+ *         GetApplicationUserModelId   (kernelbase.@)
+ */
+LONG WINAPI GetApplicationUserModelId( HANDLE process, UINT32 *length, WCHAR *id )
+{
+    DWORD pid;
+
+    TRACE( "(%p %p %p)\n", process, length, id );
+    if (!length) return ERROR_INVALID_PARAMETER;
+    if (process != GetCurrentProcess())
+    {
+        if (!(pid = GetProcessId( process ))) return GetLastError();
+        if (pid != GetCurrentProcessId())
+        {
+            /* The launcher owns the current process identity. Do not return it
+             * for another process until target-owned package queries exist. */
+            FIXME( "application identity for process %lu is not supported\n", pid );
+            return ERROR_NOT_SUPPORTED;
+        }
+    }
+    return get_package_string( L"WINE_UWP_AUMID", length, id, APPMODEL_ERROR_NO_APPLICATION );
+}
+
