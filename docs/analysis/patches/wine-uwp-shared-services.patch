--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -54,6 +54,87 @@
 
 static LONG com_server_process_refcount;
 
+struct shared_service
+{
+    struct list entry;
+    ULONG id;
+    ULONG refs;
+};
+
+static struct list shared_services = LIST_INIT(shared_services);
+static SRWLOCK shared_services_lock = SRWLOCK_INIT;
+
+/* Shared service IDs are the calling thread's service tag, not allocated cookies.
+ * Keep entries for the lifetime of the process, including entries with no refs.
+ * Windows also notifies the SCM and manages service shutdown timers here; those
+ * service-host operations have no equivalent in this process-local table yet. */
+HRESULT WINAPI CoGetSharedServiceId(ULONG *id)
+{
+    struct shared_service *service;
+    ULONG tag = (ULONG)(ULONG_PTR)NtCurrentTeb()->SubProcessTag;
+
+    if (!id) return E_INVALIDARG;
+    *id = tag;
+    AcquireSRWLockExclusive(&shared_services_lock);
+    LIST_FOR_EACH_ENTRY(service, &shared_services, struct shared_service, entry)
+    {
+        if (service->id == tag)
+        {
+            ReleaseSRWLockExclusive(&shared_services_lock);
+            return S_OK;
+        }
+    }
+    if (!(service = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*service))))
+    {
+        ReleaseSRWLockExclusive(&shared_services_lock);
+        return E_OUTOFMEMORY;
+    }
+    service->id = tag;
+    list_add_tail(&shared_services, &service->entry);
+    ReleaseSRWLockExclusive(&shared_services_lock);
+    TRACE("tag %#lx\n", tag);
+    return S_OK;
+}
+
+ULONG WINAPI CoAddRefSharedService(ULONG id)
+{
+    struct shared_service *service;
+    ULONG refs = 0;
+
+    AcquireSRWLockExclusive(&shared_services_lock);
+    LIST_FOR_EACH_ENTRY(service, &shared_services, struct shared_service, entry)
+    {
+        if (service->id != id) continue;
+        refs = ++service->refs;
+        ReleaseSRWLockExclusive(&shared_services_lock);
+        TRACE("id %#lx refs %lu\n", id, refs);
+        return refs;
+    }
+    ReleaseSRWLockExclusive(&shared_services_lock);
+    WARN("unknown shared service id %#lx\n", id);
+    return refs;
+}
+
+ULONG WINAPI CoReleaseSharedService(ULONG id)
+{
+    struct shared_service *service;
+    ULONG refs = 0;
+
+    AcquireSRWLockExclusive(&shared_services_lock);
+    LIST_FOR_EACH_ENTRY(service, &shared_services, struct shared_service, entry)
+    {
+        if (service->id != id) continue;
+        if (service->refs) refs = --service->refs;
+        else WARN("unbalanced shared service release for id %#lx\n", id);
+        ReleaseSRWLockExclusive(&shared_services_lock);
+        TRACE("id %#lx refs %lu\n", id, refs);
+        return refs;
+    }
+    ReleaseSRWLockExclusive(&shared_services_lock);
+    WARN("unknown shared service id %#lx\n", id);
+    return refs;
+}
+
 struct comclassredirect_data
 {
     ULONG size;
