+static HRESULT WINAPI manager2612_AddUserWithTransferTokenAsync( void *iface, HSTRING token, void **out )
+{
+    struct async *op;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(op = async_create( &IID_AsyncOp_AuthResult2612, R_TRANSFER, "AddUserWithTransferTokenAsync2612" )))
+        return E_OUTOFMEMORY;
+    op->i4 = 1; /* AuthResultStatus.NotSupported, not a successful sign-in. */
+    op->i4b = S_OK;
+    async_finish( op, S_OK );
+    *out = &op->obj.vtbl[0];
+    return S_OK;
+}
