+static HRESULT user_result2612( struct async *op, HRESULT hr )
+{
+    IUnknown *user = NULL;
+
+    if (FAILED(hr) || !op->iface) return hr;
+    hr = IUnknown_QueryInterface( op->iface, &IID_IUser2612, (void **)&user );
+    IUnknown_Release( op->iface );
+    op->iface = user;
+    return hr;
+}
+
+static HRESULT add_silently2612_work( struct async *op, void *ctx )
+{
+    return user_result2612( op, add_silently_work( op, ctx ) );
+}
+
+static HRESULT add_optional_ui2612_work( struct async *op, void *ctx )
+{
+    return user_result2612( op, add_optional_ui_work( op, ctx ) );
+}
+
+static HRESULT add_ui2612_work( struct async *op, void *ctx )
+{
+    return user_result2612( op, add_ui_work( op, ctx ) );
+}
+
+static HRESULT start_user2612_op( const char *name, HRESULT (*work)( struct async *, void * ), void **out )
+{
+    struct async *op;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(op = async_start( &IID_AsyncOp_User2612, R_IFACE, name, work, NULL, NULL ))) return E_OUTOFMEMORY;
+    *out = &op->obj.vtbl[0];
+    return S_OK;
+}
