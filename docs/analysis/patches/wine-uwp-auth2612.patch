+static HRESULT WINAPI manager2612_GetMsaTicketForStoreUserAsync( void *iface, UINT32 options, HSTRING scope, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (options & ~6u) return E_INVALIDARG;
+    if (options & 2) return E_NOTIMPL; /* AllowUI is not silently downgraded. */
+    return msa_ticket( scope, !!(options & 4), out );
+}
