+/* The constructor factory IID did not change. Select its default interface only
+ * for an explicitly identified client; old and new QI remain available. */
+static BOOL identity_profile2612( void )
+{
+    WCHAR profile[16];
+    DWORD n = GetEnvironmentVariableW( L"WINE_UWP_IDENTITY_ABI", profile, ARRAY_SIZE(profile) );
+    return n && n < ARRAY_SIZE(profile) && !wcscmp( profile, L"2612" );
+}
