+static BOOL windowed_capture_enabled(void)
+{
+    WCHAR value[2];
+    return GetEnvironmentVariableW(L"WINE_UWP_WEBVIEW2_WINDOWED_CAPTURE", value, ARRAY_SIZE(value)) == 1 && value[0] == L'1';
+}
+
+static HRESULT WINAPI env_CreateCoreWebView2Controller( IUnknown *iface, HWND parent, IUnknown *handler )
+{
+    struct environment *env = environment_from_iface( iface );
+    if (windowed_capture_enabled())
+        return create_captured_controller(env, parent, NULL, handler, FALSE, FALSE);
+    TRACE( "controller mode windowed-passthrough, options 0, parent %p\n", parent );
+    return CALL( fn_create, env->face.target, ENVIRONMENT_CreateController, parent, handler );
+}
+
+static HRESULT WINAPI env_CreateCoreWebView2ControllerWithOptions( IUnknown *iface, HWND parent,
+                                                                 IUnknown *options, IUnknown *handler )
+{
+    struct environment *env = environment_from_iface( iface );
+    if (windowed_capture_enabled())
+        return create_captured_controller(env, parent, options, handler, FALSE, TRUE);
+    TRACE( "controller mode windowed-passthrough, options 1, parent %p\n", parent );
+    return CALL( fn_create_opts, env->face.target, ENVIRONMENT_CreateControllerWithOptions, parent, options, handler );
+}
