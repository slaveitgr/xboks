+struct user_network_init
+{
+    XUserHandle user;
+    XUserAddOptions options;
+    IXThreadingImpl *threading;
+    XAsyncBlock *async;
+};
+
+static DWORD WINAPI user_network_init_thread( void *arg )
+{
+    struct user_network_init *init = arg;
+    XUserHandle user = init->user;
+    XUserAddOptions options = init->options;
+    IXThreadingImpl *threading = init->threading;
+    XAsyncBlock *async = init->async;
+    HRESULT hr, com = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    int attempt;
+
+    free( init );
+    for (attempt = 0; attempt < 5; attempt++)
+    {
+        hr = user_initialize_network( user, options );
+        if (SUCCEEDED(hr)) break;
+        /* Transient bridge/service start races must not permanently break
+         * sign-in; retry with a delay before publishing the failure. */
+        if (attempt < 4) Sleep( 3000 );
+    }
+    if (SUCCEEDED(com)) CoUninitialize();
+    EnterCriticalSection( &user->deviceAuthSection );
+    user->initResult = hr;
+    user->initDone = 1;
+    LeaveCriticalSection( &user->deviceAuthSection );
+    WakeAllConditionVariable( &user->initCv );
+    /* XUserAddResult must expose an initialized identity. Do not manufacture
+     * SignedInAgain: that event is reserved for an existing signed-out handle
+     * whose same user subsequently signs in again. */
+    if (SUCCEEDED(hr)) set_signed_in_user( user );
+    IUser_Release( &user->IUser_iface );
+    IXThreadingImpl_XAsyncComplete( threading, async, hr, SUCCEEDED(hr) ? sizeof(XUserHandle) : 0 );
+    IXThreadingImpl_Release( threading );
+    return 0;
+}
+
+/* Bounded wait for the background identity/network initialization. */
+static HRESULT user_wait_init( XUserHandle user )
+{
+    HRESULT hr;
+
+    EnterCriticalSection( &user->deviceAuthSection );
+    while (!user->initDone)
+    {
+        if (!SleepConditionVariableCS( &user->initCv, &user->deviceAuthSection, 120000 ))
+        {
+            LeaveCriticalSection( &user->deviceAuthSection );
+            return HRESULT_FROM_WIN32( GetLastError() );
+        }
+    }
+    hr = user->initResult;
+    LeaveCriticalSection( &user->deviceAuthSection );
+    return hr;
+}
