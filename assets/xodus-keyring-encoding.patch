--- a/crates/xodus/src/tokens/backend/keychain.rs
+++ b/crates/xodus/src/tokens/backend/keychain.rs
@@ -1,4 +1,40 @@
+use base64::{Engine as _, engine::general_purpose::STANDARD};
+
 use crate::tokens::store::{TokenBackend, TokenStoreError};
+
+// GNOME Keyring's passwordless textual format writes secrets with
+// g_key_file_set_value but reads them with g_key_file_get_string. Backslash
+// escapes in JSON (notably XML token attributes) can therefore be rejected or
+// changed on reload. ASCII base64 avoids those escapes without changing the
+// selected keyring or its security policy. This is encoding, not encryption.
+const ENVELOPE: &[u8] = b"XODUS_KEYRING_BASE64_V1:";
+
+fn encode_secret(value: &[u8]) -> Vec<u8> {
+    let mut encoded = ENVELOPE.to_vec();
+    encoded.extend_from_slice(STANDARD.encode(value).as_bytes());
+    encoded
+}
+
+fn decode_secret(bytes: Vec<u8>) -> Result<Vec<u8>, TokenStoreError> {
+    match bytes.strip_prefix(ENVELOPE) {
+        Some(encoded) => STANDARD.decode(encoded).map_err(|_| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "Invalid encoded Xodus credential",
+            )
+            .into()
+        }),
+        // Existing credentials are raw JSON. Do not rewrite or delete on reads.
+        None => Ok(bytes),
+    }
+}
+
+fn deletion_result(result: Result<(), keyring_core::Error>) -> Result<(), TokenStoreError> {
+    match result {
+        Ok(()) | Err(keyring_core::Error::NoEntry) => Ok(()),
+        Err(error) => Err(error.into()),
+    }
+}
 
 pub struct KeychainBackend;
 
