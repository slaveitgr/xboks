+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn credential_encoding_preserves_xml_json_and_binary() {
+        let xml_json = br#"{"token":"<EncryptedData Id=\"synthetic\">dummy</EncryptedData>","escapes":"a\\b\n\t\r"}"#;
+        let binary: Vec<u8> = (0..=255).collect();
+        for value in [
+            xml_json.as_slice(),
+            b"".as_slice(),
+            binary.as_slice(),
+            "synthetic-\u{00e9}".as_bytes(),
+        ] {
+            let encoded = encode_secret(value);
+            assert!(encoded.starts_with(ENVELOPE));
+            // No GKeyFile escapes or physical line breaks can be introduced.
+            assert!(encoded.is_ascii());
+            assert!(
+                !encoded
+                    .iter()
+                    .any(|byte| matches!(byte, b'\\' | b'\n' | b'\r' | 0))
+            );
+            assert_eq!(decode_secret(encoded).unwrap(), value);
+        }
+    }
+
+    #[test]
+    fn credential_encoding_accepts_legacy_values_without_rewriting() {
+        for value in [
+            br#"{"username":"synthetic"}"#.as_slice(),
+            b"".as_slice(),
+            b"invalid legacy JSON".as_slice(),
+        ] {
+            // Validation of legacy JSON remains the TokenManager's job.
+            assert_eq!(decode_secret(value.to_vec()).unwrap(), value);
+        }
+    }
+
+    #[test]
+    fn credential_encoding_rejects_malformed_envelopes_without_leaking_values() {
+        for bad in [
+            b"%%%synthetic-secret-never-print".as_slice(),
+            b"YQ".as_slice(),
+        ] {
+            let mut encoded = ENVELOPE.to_vec();
+            encoded.extend_from_slice(bad);
+            let error = decode_secret(encoded).unwrap_err();
+            assert!(matches!(error, TokenStoreError::Io(_)));
+            assert!(!error.to_string().contains("synthetic-secret-never-print"));
+        }
+    }
+
+    #[test]
+    fn credential_deletion_is_idempotent_but_keeps_other_errors() {
+        assert!(deletion_result(Ok(())).is_ok());
+        assert!(deletion_result(Err(keyring_core::Error::NoEntry)).is_ok());
+        assert!(matches!(
+            deletion_result(Err(keyring_core::Error::Invalid(
+                "synthetic".into(),
+                "failure".into()
+            ))),
+            Err(TokenStoreError::Keychain(_))
+        ));
+    }
+}
