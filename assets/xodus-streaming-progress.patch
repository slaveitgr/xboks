diff --git a/crates/xodus-cli/src/commands/streaming_progress.rs b/crates/xodus-cli/src/commands/streaming_progress.rs
new file mode 100644
index 0000000..dd9f906
--- /dev/null
+++ b/crates/xodus-cli/src/commands/streaming_progress.rs
@@ -0,0 +1,227 @@
+//! Versioned progress/control protocol. Never emits paths, URLs or credentials.
+use super::ProgressEvent;
+use std::{
+    collections::HashMap,
+    io::{BufRead, Write},
+    time::{Duration, Instant},
+};
+use tokio::sync::{mpsc, watch};
+
+pub(super) fn controls(
+    enabled: bool,
+    events: mpsc::Sender<ProgressEvent>,
+) -> watch::Receiver<bool> {
+    let (tx, rx) = watch::channel(false);
+    if enabled {
+        // A plain thread avoids Tokio's uncancellable blocking-stdin shutdown.
+        std::thread::spawn(move || {
+            let stdin = std::io::stdin();
+            let mut reader = stdin.lock();
+            let mut bytes = Vec::new();
+            loop {
+                bytes.clear();
+                // Bound control records; discard overlong lines without parsing.
+                let result = std::io::Read::take(std::io::Read::by_ref(&mut reader), 257)
+                    .read_until(b'\n', &mut bytes);
+                if !matches!(result, Ok(n) if n > 0) {
+                    break;
+                }
+                if bytes.len() > 256 {
+                    if bytes.last() != Some(&b'\n') {
+                        reader.skip_until(b'\n').ok();
+                    }
+                    continue;
+                }
+                if let Some(paused) = parse_control(&bytes) {
+                    if *tx.borrow() == paused {
+                        continue;
+                    }
+                    if tx.send(paused).is_err() {
+                        return;
+                    }
+                    if events
+                        .blocking_send(ProgressEvent::Paused { paused })
+                        .is_err()
+                    {
+                        return;
+                    }
+                }
+            }
+            // Losing the controller must never leave a live download parked.
+            if *tx.borrow() {
+                tx.send(false).ok();
+                events
+                    .blocking_send(ProgressEvent::Paused { paused: false })
+                    .ok();
+            }
+        });
+    } else {
+        drop(tx);
+    }
+    rx
+}
+
+fn parse_control(bytes: &[u8]) -> Option<bool> {
+    let value: serde_json::Value = serde_json::from_slice(bytes).ok()?;
+    if value["schema"] != 1 {
+        return None;
+    }
+    match value["command"].as_str()? {
+        "pause" => Some(true),
+        "resume" => Some(false),
+        _ => None,
+    }
+}
+
+#[derive(Default)]
+struct State {
+    completed: u64,
+    total: Option<u64>,
+    phase: &'static str,
+    paused: bool,
+    files: HashMap<usize, (u64, u64)>,
+}
+
+impl State {
+    fn apply(&mut self, event: ProgressEvent) -> bool {
+        match event {
+            ProgressEvent::Started { id, total, .. } => {
+                self.files.insert(id, (0, total));
+            }
+            ProgressEvent::Advanced { id, delta } => {
+                if self.phase == "downloading" {
+                    if let Some((position, total)) = self.files.get_mut(&id) {
+                        let next = position.saturating_add(delta).min(*total);
+                        self.completed = self.completed.saturating_add(next - *position);
+                        *position = next;
+                    }
+                }
+            }
+            ProgressEvent::Finished { id } => {
+                if let Some((position, total)) = self.files.remove(&id) {
+                    // A full progress channel can coalesce the last byte update.
+                    self.completed = self.completed.saturating_add(total - position);
+                }
+            }
+            ProgressEvent::UpdateRemaining { total, .. } => {
+                self.phase = "downloading";
+                self.total = Some(total);
+                self.completed = 0;
+                return true;
+            }
+            ProgressEvent::UpdateStatus { name } => {
+                self.phase = if name == "Finalizing" {
+                    "finalizing"
+                } else {
+                    "metadata"
+                };
+                return true;
+            }
+            ProgressEvent::Paused { paused } => {
+                self.paused = paused;
+                return true;
+            }
+            ProgressEvent::Completed { success } => {
+                self.phase = if success { "complete" } else { "failed" };
+                return true;
+            }
+        }
+        false
+    }
+
+    fn record(&self, sequence: u64, rate: u64) -> serde_json::Value {
+        serde_json::json!({
+            "schema": 1, "event": "progress", "sequence": sequence,
+            "phase": self.phase, "paused": self.paused,
+            "canPause": self.phase == "downloading",
+            "completedBytes": self.completed, "totalBytes": self.total,
+            "bytesPerSecond": rate,
+        })
+    }
+}
+
+pub(super) async fn report(mut events: mpsc::Receiver<ProgressEvent>) {
+    let mut state = State {
+        phase: "initializing",
+        ..Default::default()
+    };
+    let mut sequence = 0;
+    let mut last = Instant::now();
+    let mut previous = 0;
+    emit(&state, sequence, 0);
+    while let Some(event) = events.recv().await {
+        let transition = state.apply(event);
+        let elapsed = last.elapsed();
+        if transition || elapsed >= Duration::from_millis(200) {
+            let rate = if state.paused {
+                0
+            } else {
+                (state.completed.saturating_sub(previous) as f64 / elapsed.as_secs_f64().max(0.001))
+                    as u64
+            };
+            sequence += 1;
+            emit(&state, sequence, rate);
+            last = Instant::now();
+            previous = state.completed;
+        }
+        if matches!(state.phase, "complete" | "failed") {
+            break;
+        }
+    }
+}
+
+fn emit(state: &State, sequence: u64, rate: u64) {
+    let stdout = std::io::stdout();
+    let mut out = stdout.lock();
+    // Explicit prefix isolates the protocol from any ordinary CLI log output.
+    writeln!(out, "NEXUS_PROGRESS {}", state.record(sequence, rate)).ok();
+    out.flush().ok();
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn streaming_progress_counts_files_once_and_reconciles_coalesced_tail() {
+        let mut state = State::default();
+        state.apply(ProgressEvent::UpdateRemaining {
+            name: "Downloading".into(),
+            total: 100,
+        });
+        state.apply(ProgressEvent::Started {
+            id: 1,
+            name: "private path".into(),
+            total: 100,
+        });
+        state.apply(ProgressEvent::Advanced {
+            id: usize::MAX,
+            delta: 9999,
+        });
+        state.apply(ProgressEvent::Advanced { id: 1, delta: 30 });
+        assert_eq!(state.completed, 30);
+        state.apply(ProgressEvent::Finished { id: 1 });
+        state.apply(ProgressEvent::Finished { id: 1 });
+        assert_eq!(state.completed, 100);
+        assert!(!state.record(1, 2).to_string().contains("private path"));
+    }
+    #[test]
+    fn streaming_progress_preserves_real_failure_and_control_contract() {
+        assert_eq!(
+            parse_control(br#"{"schema":1,"command":"pause"}"#),
+            Some(true)
+        );
+        assert_eq!(
+            parse_control(br#"{"schema":1,"command":"resume"}"#),
+            Some(false)
+        );
+        assert_eq!(parse_control(br#"{"schema":2,"command":"pause"}"#), None);
+        let mut state = State {
+            completed: 30,
+            total: Some(100),
+            ..Default::default()
+        };
+        state.apply(ProgressEvent::Completed { success: false });
+        assert_eq!(state.record(2, 0)["phase"], "failed");
+        assert_eq!(state.completed, 30);
+    }
+}
diff --git a/crates/xodus-cli/src/commands/streaming_resume.rs b/crates/xodus-cli/src/commands/streaming_resume.rs
new file mode 100644
index 0000000..5eff8ed
--- /dev/null
+++ b/crates/xodus-cli/src/commands/streaming_resume.rs
@@ -0,0 +1,199 @@
+//! Durable checkpoints for the exact package layout, never CDN URLs/tokens.
+use msixvc::streaming::resume_digest;
+use msixvc::xvd::SegmentFile;
+use std::{
+    collections::HashMap,
+    fs::{self, File},
+    io::{self, BufRead, Read, Seek, SeekFrom, Write},
+    path::{Component, Path, PathBuf},
+};
+
+pub(super) struct Journal {
+    root: PathBuf,
+    identity: String,
+    entries: serde_json::Map<String, serde_json::Value>,
+}
+
+pub(super) fn lock(root: &Path) -> io::Result<File> {
+    let path = target(root, ".nexus-streaming.lock")?;
+    let file = fs::OpenOptions::new()
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(path)?;
+    fs2::FileExt::try_lock_exclusive(&file)
+        .map_err(|_| io::Error::other("another download is using this folder"))?;
+    Ok(file)
+}
+
+pub(super) fn target(root: &Path, name: &str) -> io::Result<PathBuf> {
+    let relative = name.replace('\\', "/");
+    let relative = Path::new(&relative);
+    if relative
+        .components()
+        .any(|c| !matches!(c, Component::Normal(_)))
+    {
+        return Err(io::Error::other("unsafe package filename"));
+    }
+    let mut path = root.to_owned();
+    for component in relative.components() {
+        path.push(component);
+        if fs::symlink_metadata(&path).is_ok_and(|m| m.file_type().is_symlink()) {
+            return Err(io::Error::other("symlink in package download path"));
+        }
+    }
+    Ok(path)
+}
+
+impl Journal {
+    pub(super) fn open(
+        root: &Path,
+        content: &str,
+        files: &HashMap<String, SegmentFile>,
+    ) -> io::Result<Self> {
+        let mut layout: Vec<_> = files
+            .iter()
+            .map(|(name, f)| (name, f.offset, f.length, f.keep_encrypted, &f.data_hashs))
+            .collect();
+        layout.sort_by(|a, b| a.0.cmp(b.0));
+        let identity = resume_digest(&serde_json::to_vec(&(content, layout))?);
+        let path = target(root, ".nexus-streaming-v1.jsonl")?;
+        let mut entries = serde_json::Map::new();
+        if let Ok(file) = File::open(&path) {
+            // A torn final append is ignored; previously synced records survive.
+            for line in std::io::BufReader::new(file.take(64 * 1024 * 1024)).split(b'\n') {
+                let Ok(line) = line else {
+                    break;
+                };
+                if line.len() > 4096 {
+                    continue;
+                }
+                if let Ok(value) = serde_json::from_slice::<serde_json::Value>(&line) {
+                    if value["schema"] == 1 && value["identity"].as_str() == Some(identity.as_str())
+                    {
+                        if let Some(name) = value["file"].as_str() {
+                            entries.insert(name.to_owned(), value["checkpoint"].clone());
+                        }
+                    }
+                }
+            }
+        }
+        let journal = Self {
+            root: root.to_owned(),
+            identity,
+            entries,
+        };
+        journal.compact()?;
+        Ok(journal)
+    }
+
+    pub(super) fn offset(&self, name: &str, length: u64) -> u64 {
+        let Some(entry) = self.entries.get(name) else {
+            return 0;
+        };
+        let Some(offset) = entry["offset"]
+            .as_u64()
+            .filter(|v| *v <= length && (*v == length || *v % 4096 == 0))
+        else {
+            return 0;
+        };
+        let valid = target(&self.root, name)
+            .and_then(|path| tail(&path, offset))
+            .is_ok_and(|digest| entry["tailSha256"].as_str() == Some(digest.as_str()));
+        if valid { offset } else { 0 }
+    }
+
+    pub(super) fn checkpoint(&mut self, name: &str, offset: u64) -> io::Result<()> {
+        let file = target(&self.root, name)?;
+        // File data reaches storage before the journal claims it can be resumed.
+        File::open(&file)?.sync_data()?;
+        let digest = tail(&file, offset)?;
+        let entry = serde_json::json!({"offset": offset, "tailSha256": digest});
+        let path = target(&self.root, ".nexus-streaming-v1.jsonl")?;
+        let mut out = fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)?;
+        writeln!(out, "{}", self.record(name, &entry))?;
+        out.sync_all()?;
+        self.entries.insert(name.to_owned(), entry);
+        Ok(())
+    }
+
+    fn record(&self, name: &str, entry: &serde_json::Value) -> serde_json::Value {
+        serde_json::json!({"schema":1, "identity":self.identity, "file":name, "checkpoint":entry})
+    }
+
+    fn compact(&self) -> io::Result<()> {
+        let path = self.root.join(".nexus-streaming-v1.jsonl");
+        let temp = self
+            .root
+            .join(format!(".nexus-streaming-{}.tmp", uuid::Uuid::new_v4()));
+        let result = (|| {
+            let mut out = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&temp)?;
+            for (name, entry) in &self.entries {
+                writeln!(out, "{}", self.record(name, entry))?;
+            }
+            out.sync_all()?;
+            fs::rename(&temp, &path)?;
+            File::open(&self.root)?.sync_all()
+        })();
+        if result.is_err() {
+            fs::remove_file(&temp).ok();
+        }
+        result
+    }
+}
+
+fn tail(path: &Path, offset: u64) -> io::Result<String> {
+    let mut file = File::open(path)?;
+    if !file.metadata()?.is_file() || file.metadata()?.len() < offset {
+        return Err(io::Error::other("checkpoint file is incomplete"));
+    }
+    let start = offset.saturating_sub(65536);
+    file.seek(SeekFrom::Start(start))?;
+    let mut bytes = vec![0; (offset - start) as usize];
+    file.read_exact(&mut bytes)?;
+    Ok(resume_digest(&bytes))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn streaming_resume_reopens_checkpoint_and_rejects_changed_data_or_package() {
+        let root = tempfile::tempdir().unwrap();
+        let files = HashMap::from([(
+            "game.bin".to_owned(),
+            SegmentFile {
+                offset: 0,
+                length: 8192,
+                keep_encrypted: false,
+                data_hashs: vec![],
+            },
+        )]);
+        fs::write(root.path().join("game.bin"), vec![7; 8192]).unwrap();
+        let mut journal = Journal::open(root.path(), "package-A", &files).unwrap();
+        journal.checkpoint("game.bin", 4096).unwrap();
+        assert_eq!(
+            Journal::open(root.path(), "package-A", &files)
+                .unwrap()
+                .offset("game.bin", 8192),
+            4096
+        );
+        fs::write(root.path().join("game.bin"), vec![8; 8192]).unwrap();
+        assert_eq!(journal.offset("game.bin", 8192), 0);
+        assert_eq!(
+            Journal::open(root.path(), "package-B", &files)
+                .unwrap()
+                .offset("game.bin", 8192),
+            0
+        );
+        assert!(target(root.path(), "../outside").is_err());
+        let _guard = lock(root.path()).unwrap();
+        assert!(lock(root.path()).is_err());
+    }
+}
