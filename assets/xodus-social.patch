+// The companion must coexist with backends using the older keyring encoding.
+// Read current cached credentials only: no device renewal, provisioning, login,
+// migration, cache save or TokenManager mutation. Expiry remains an explicit gate.
+pub(super) fn readonly_credentials(tokens: &TokenManager) -> Result<(String, xodus::models::secrets::LegacyToken, xodus::models::secrets::LegacyToken), &'static str> {
+    use xodus::tokens::session::{state,State};
+    let account = tokens.get_user().map_err(|_| "stored-account")?.username;
+    let device = tokens.get_device_sts_token().map_err(|_| "session-device-renewal-required")?;
+    let user = tokens.get_user_sts_token().map_err(|_| "session-user-renewal-required")?;
+    for (token,expired) in [(&device,"session-device-renewal-required"),(&user,"session-user-renewal-required")] {
+        match state(token,chrono::Utc::now()) {
+            State::Current => {}, State::Expired => return Err(expired), State::Invalid => return Err("session-token-invalid")
+        }
+    }
+    if tokens.get_user().map_err(|_| "account-changed")?.username != account { return Err("account-changed"); }
+    let (Token::Legacy(device),Token::Legacy(user)) = (device,user) else { return Err("session-token-invalid"); };
+    Ok((account,device,user))
+}
+pub(super) async fn xbox_session_readonly(tokens: &TokenManager) -> Result<(reqwest::Client, String, String), &'static str> {
+    let (account,device,user) = readonly_credentials(tokens)?;
