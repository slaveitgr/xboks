+//! Bounded Xbox consumer social adapter. Contracts: OpenXbox/xbox-webapi-python
+//! 672f34f256f18640d387147867950234fc2e140f, people/message/usersearch providers.
+//! No presence writes, mark-read, friendship mutations, group chat or party media.
+use std::{collections::HashSet, process::ExitCode, time::Duration};
+use clap::Subcommand;
+use serde_json::{Value, json};
+use xodus::tokens::TokenManager;
+use super::profile::{bounded, xbox_session_readonly};
+
+const BODY_LIMIT: usize = 2 * 1024 * 1024;
+const INPUT_LIMIT: usize = 8192;
+const OWN_PROFILE: &str = "https://profile.xboxlive.com/users/me/profile/settings?settings=Gamertag";
+const FRIENDS: &str = "https://peoplehub.xboxlive.com/users/me/people/friends/decoration/detail,presenceDetail";
+const INBOX: &str = "https://xblmessaging.xboxlive.com/network/Xbox/users/me/inbox";
+const SEARCH: &str = "https://usersearch.xboxlive.com/suggest";
+
+// Defense in depth: even a future social helper cannot rewrite credentials in
+// an encoding an independently selected older backend cannot read.
+struct ReadOnlyBackend { inner: std::sync::Arc<dyn xodus::tokens::store::TokenBackend> }
+impl xodus::tokens::store::TokenBackend for ReadOnlyBackend {
+    fn get(&self,key:&str) -> Result<Option<Vec<u8>>,xodus::tokens::store::TokenStoreError> { self.inner.get(key) }
+    fn set(&self,_:&str,_:&[u8]) -> Result<(),xodus::tokens::store::TokenStoreError> {
+        Err(std::io::Error::new(std::io::ErrorKind::PermissionDenied,"read-only social credentials").into())
+    }
+    fn remove(&self,_:&str) -> Result<(),xodus::tokens::store::TokenStoreError> {
+        Err(std::io::Error::new(std::io::ErrorKind::PermissionDenied,"read-only social credentials").into())
+    }
+}
+pub fn readonly_manager() -> TokenManager {
+    use std::sync::Arc;
+    use xodus::tokens::backend::{KeychainBackend,MemoryBackend};
+    TokenManager::new(Arc::new(ReadOnlyBackend {inner:Arc::new(KeychainBackend)}),Arc::new(MemoryBackend::default()))
+}
+
+#[derive(Subcommand)]
+pub enum SocialCommand {
+    #[command(about = "Read friends and explicitly supplied presence without publishing presence")]
+    Friends,
+    #[command(about = "Read the latest 100 primary one-to-one conversations without marking them read")]
+    Inbox,
+    #[command(about = "Read the latest 100 messages with one Xbox player without marking them read")]
+    Conversation { #[arg(value_parser = parse_peer)] peer: String },
+    #[command(about = "Find players; supply JSON {\"query\":\"name\"} on stdin, never in arguments")]
+    Search,
+    #[command(about = "Send once to one player; supply JSON {\"text\":\"message\"} on stdin; no automatic retry")]
+    Send { #[arg(value_parser = parse_peer)] peer: String },
+}
+
+fn decimal(s: &str) -> bool {
+    !s.is_empty() && !s.starts_with('0') && s.len() <= 20
+        && s.bytes().all(|b| b.is_ascii_digit()) && s.parse::<u64>().is_ok()
+}
+fn parse_peer(s: &str) -> Result<String, String> {
+    if decimal(s) { Ok(s.into()) } else { Err("Expected a positive decimal Xbox player ID".into()) }
+}
+fn clean(s: &str, max: usize, multiline: bool) -> bool {
+    !s.is_empty() && s.len() <= max && !s.chars().any(|c| c.is_control() && !(multiline && matches!(c, '\n' | '\r' | '\t')))
+}
+fn field(v: &Value, key: &str, max: usize) -> Option<String> {
+    v[key].as_str().filter(|s| clean(s, max, false)).map(str::to_owned)
+}
+fn id(v: &Value, key: &str) -> Result<String, &'static str> {
+    field(v, key, 256).filter(|s| !s.chars().any(char::is_whitespace)).ok_or("response-id")
+}
+fn date(v: &Value, key: &str) -> Option<String> {
+    v[key].as_str().filter(|s| s.len() <= 40)
+        .and_then(|s| chrono::DateTime::parse_from_rfc3339(s).ok())
+        .map(|d| d.to_rfc3339_opts(chrono::SecondsFormat::Millis, true))
+}
+fn picture(v: &Value, key: &str) -> Option<String> {
+    let s = v[key].as_str().filter(|s| s.len() <= 4096)?;
+    let u = reqwest::Url::parse(s).ok()?;
+    if u.scheme() != "https" || !u.username().is_empty() || u.password().is_some() || u.port().is_some()
+        || !["gamerpic.xboxlive.com", "images-eds-ssl.xboxlive.com", "avatar-ssl.xboxlive.com", "xboxavatargamerpic.azureedge.net"].contains(&u.host_str()?) { return None; }
+    Some(u.into())
+}
+fn self_xuid(v: &Value) -> Result<String, &'static str> {
+    let users = v["profileUsers"].as_array().ok_or("profile-shape")?;
+    if users.len() != 1 { return Err("profile-count"); }
+    users[0]["id"].as_str().filter(|s| decimal(s)).map(str::to_owned).ok_or("profile-id")
+}
+fn person(v: &Value, search: bool) -> Result<Value, &'static str> {
+    let xuid = v[if search { "id" } else { "xuid" }].as_str().filter(|s| decimal(s)).ok_or("people-id")?;
+    let name = field(v, "gamertag", 256).filter(|s| !s.trim().is_empty()).ok_or("people-name")?;
+    let state = if search || v["isCloaked"] == true { "unknown" } else {
+        match v["presenceState"].as_str().unwrap_or("").to_ascii_lowercase().as_str() {
+            "online" => "online", "away" => "away", "offline" => "offline", _ => "unknown"
+        }
+    };
+    let mut p = json!({"xuid":xuid,"gamertag":name,"presence":state});
+    if let Some(url) = picture(v, if search { "displayPicUri" } else { "displayPicRaw" }) { p["gamerpicUrl"] = json!(url); }
+    if !search && v["isCloaked"] != true {
+        if let Some(t) = field(v, "presenceText", 512) { p["activity"] = json!(t); }
+        if let Some(t) = date(v, "lastSeenDateTimeUtc") { p["lastSeenAt"] = json!(t); }
+    }
+    Ok(p)
+}
+fn people(v: &Value, search: bool) -> Result<Vec<Value>, &'static str> {
+    let rows = v[if search { "results" } else { "people" }].as_array().ok_or("people-shape")?;
+    if rows.len() > if search { 100 } else { 2000 } { return Err("people-count"); }
+    let mut seen = HashSet::new();
+    rows.iter().map(|r| {
+        let p = person(if search { &r["result"] } else { r }, search)?;
+        if !seen.insert(p["xuid"].as_str().unwrap().to_owned()) { return Err("people-duplicate"); }
+        Ok(p)
+    }).collect()
+}
+fn message(v: &Value, own: &str, peer: &str, conversation: &str) -> Result<Value, &'static str> {
+    if v["networkId"] != "Xbox" || v["conversationType"] != "OneToOne" || v["conversationId"] != conversation { return Err("message-conversation"); }
+    let sender = v["sender"].as_str().filter(|s| *s == own || *s == peer).ok_or("message-sender")?;
+    let deleted = v["isDeleted"].as_bool().ok_or("message-deleted")?;
+    let mut m = json!({"id":id(v,"messageId")?,"senderXuid":sender,"deleted":deleted});
+    if let Some(t) = date(v,"timestamp") { m["sentAt"] = json!(t); }
+    if !deleted && v["type"] == "ContentMessage" {
+        if let Some(parts) = v["contentPayload"]["content"]["parts"].as_array() {
+            if parts.len() > 32 { return Err("message-parts"); }
+            // Treat any safety-filtered or malformed part as unavailable. Never
+            // expose locators, HTML/media or text the server marked unsuitable.
+            let safe = parts.iter().all(|p| p["contentType"] == "text" && p["version"] == 0
+                && (p["unsuitableFor"].is_null() || p["unsuitableFor"].as_array().is_some_and(Vec::is_empty))
+                && p["text"].as_str().is_some_and(|s| clean(s, 16384, true)));
+            if safe && !parts.is_empty() {
+                let text = parts.iter().map(|p| p["text"].as_str().unwrap()).collect::<Vec<_>>().join("\n");
+                if text.len() <= 16384 { m["text"] = json!(text); }
+            }
+        }
+    }
+    Ok(m)
+}
+fn participants(v: &Value, own: &str, requested: Option<&str>) -> Result<Option<(String, Vec<String>)>, &'static str> {
+    let Some(rows) = v["participants"].as_array() else {
+        // The service uses null participants for a new/empty OneToOne thread.
+        return if v["participants"].is_null() && requested.is_some() && v["messages"].is_null() {
+            Ok(Some((requested.unwrap().into(), Vec::new())))
+        } else { Err("conversation-participants") };
+    };
+    if rows.len() != 2 { return Ok(None); }
+    let ids = rows.iter().map(|v| v.as_str().map(str::to_owned).ok_or("conversation-participants")).collect::<Result<Vec<_>,_>>()?;
+    // Xbox system notices use player ID 0 and have no supported reply target.
+    if ids.iter().any(|s| s == "0") { return Ok(None); }
+    if ids.iter().any(|s| !decimal(s)) || ids[0] == ids[1] || !ids.iter().any(|s| s == own) { return Err("conversation-identity"); }
+    let peer = ids.iter().find(|s| s.as_str() != own).unwrap().clone();
+    if requested.is_some_and(|r| r != peer) { return Err("conversation-target"); }
+    Ok(Some((peer, ids)))
+}
+fn inbox(v: &Value, own: &str) -> Result<(Vec<Value>, usize), &'static str> {
+    let rows = v["primary"]["conversations"].as_array().ok_or("inbox-shape")?;
+    if rows.len() > 100 { return Err("inbox-count"); }
+    let mut result = Vec::new(); let mut omitted = 0; let mut seen = HashSet::new();
+    for row in rows {
+        if row["networkId"] != "Xbox" || row["type"] != "OneToOne" { omitted += 1; continue; }
+        let Some((peer, ids)) = participants(row, own, None)? else { omitted += 1; continue; };
+        let key = id(row,"conversationId")?;
+        if !seen.insert(key.clone()) { return Err("inbox-duplicate"); }
+        let read = row["isRead"].as_bool().ok_or("inbox-read")?;
+        let mut c = json!({"id":key,"peerXuid":peer,"participants":ids,"unread":!read});
+        if let Some(t) = date(row,"timestamp") { c["updatedAt"] = json!(t); }
+        if !row["lastMessage"].is_null() { c["lastMessage"] = message(&row["lastMessage"],own,&peer,&key)?; }
+        result.push(c);
+    }
+    Ok((result, omitted))
+}
+fn conversation(v: &Value, own: &str, peer: &str) -> Result<(Vec<Value>, Option<String>), &'static str> {
+    if v["networkId"] != "Xbox" || v["type"] != "OneToOne" { return Err("conversation-type"); }
+    participants(v,own,Some(peer))?.ok_or("conversation-type")?;
+    let key = id(v,"conversationId")?;
+    let mut seen = HashSet::new();
+    let mut result = Vec::new();
+    if !v["messages"].is_null() {
+        let rows = v["messages"].as_array().ok_or("messages-shape")?;
+        if rows.len() > 100 { return Err("messages-count"); }
+        for row in rows {
+            let m = message(row,own,peer,&key)?;
+            if !seen.insert(m["id"].as_str().unwrap().to_owned()) { return Err("message-duplicate"); }
+            result.push(m);
+        }
+    }
+    let token = if v["continuationToken"].is_null() { None } else { Some(field(v,"continuationToken",8192).ok_or("continuation-token")?) };
+    Ok((result,token))
+}
+fn input(bytes: &[u8], send: bool) -> Result<String, &'static str> {
+    if bytes.len() > INPUT_LIMIT { return Err("stdin-size"); }
+    let v: Value = serde_json::from_slice(bytes).map_err(|_| "stdin-json")?;
+    let key = if send { "text" } else { "query" };
+    if v.as_object().is_none_or(|o| o.len() != 1 || !o.contains_key(key)) { return Err("stdin-shape"); }
+    let s = v[key].as_str().ok_or("stdin-shape")?;
+    if !clean(s,2048,send) || s.trim().is_empty() || s.chars().count() > if send { 256 } else { 64 } { return Err("stdin-text"); }
+    Ok(if send { s.to_owned() } else { s.trim().to_owned() })
+}
+#[cfg(unix)]
+fn read_input(send: bool) -> Result<String, &'static str> {
+    use std::io::IsTerminal;
+    use nix::libc;
+    if std::io::stdin().is_terminal() { return Err("stdin-required"); }
+    let until = std::time::Instant::now() + Duration::from_secs(5);
+    let mut bytes = Vec::new();
+    loop {
+        let remaining = until.saturating_duration_since(std::time::Instant::now());
+        if remaining.is_zero() { return Err("stdin-timeout"); }
+        let mut fd = libc::pollfd { fd:libc::STDIN_FILENO,events:libc::POLLIN|libc::POLLHUP,revents:0 };
+        // poll/read are bounded to stdin only; no terminal prompting or input echo.
+        let ready = unsafe { libc::poll(&mut fd,1,remaining.as_millis().min(i32::MAX as u128) as i32) };
+        if ready < 0 { if std::io::Error::last_os_error().kind() == std::io::ErrorKind::Interrupted { continue; } return Err("stdin-read"); }
+        if ready == 0 { return Err("stdin-timeout"); }
+        if fd.revents & (libc::POLLERR|libc::POLLNVAL) != 0 { return Err("stdin-read"); }
+        let mut chunk = [0u8;1024];
+        let n = unsafe { libc::read(libc::STDIN_FILENO,chunk.as_mut_ptr().cast(),chunk.len()) };
+        if n < 0 { if std::io::Error::last_os_error().kind() == std::io::ErrorKind::Interrupted { continue; } return Err("stdin-read"); }
+        if n == 0 { return input(&bytes,send); }
+        if bytes.len()+n as usize > INPUT_LIMIT { return Err("stdin-size"); }
+        bytes.extend_from_slice(&chunk[..n as usize]);
+    }
+}
+#[cfg(not(unix))]
+fn read_input(_: bool) -> Result<String, &'static str> { Err("stdin-unsupported") }
+
+fn account_matches(tokens: &TokenManager, account: &str) -> Result<(), &'static str> {
+    if tokens.get_user().map_err(|_| "account-changed")?.username != account { return Err("account-changed"); }
+    Ok(())
+}
+fn get(client: &reqwest::Client, url: &str, auth: &str, contract: &str) -> reqwest::RequestBuilder {
+    client.get(url).header("Authorization",auth).header("x-xbl-contract-version",contract)
+        .header("Accept-Language","en-US").header("Accept","application/json")
+}
+async fn json_response(response: reqwest::Response) -> Result<Value, &'static str> {
+    let bytes = bounded(response,BODY_LIMIT).await?;
+    serde_json::from_slice(&bytes).map_err(|_| "response-json")
+}
+// Deliberately one POST, no retry, including after timeout/reset. Tests exercise
+// this transport against a local fixture only, never a stored Xbox session.
+async fn send_once(request: reqwest::RequestBuilder) -> Result<Value, &'static str> {
+    let response = request.send().await.map_err(|_| "send-delivery-unconfirmed")?;
+    if !response.status().is_success() { return Err("send-http-rejected"); }
+    // Receipt of a 2xx confirms acceptance even if an optional response body is
+    // absent/malformed or the connection drops afterwards. Retrying duplicates it.
+    let mut receipt = json!({});
+    if let Ok(bytes) = bounded(response,64*1024).await {
+        if let Ok(v) = serde_json::from_slice::<Value>(&bytes) {
+            for key in ["messageId","conversationId"] { if let Ok(value) = id(&v,key) { receipt[key] = json!(value); } }
+        }
+    }
+    Ok(receipt)
+}
+async fn lookup(tokens: &TokenManager, command: &SocialCommand, payload: Option<String>) -> Result<Value, &'static str> {
+    let (_, auth, account) = xbox_session_readonly(tokens).await?;
+    // Disable reqwest's protocol-level retries as well as application retries.
+    // A POST whose outcome is unknown must never be silently replayed.
+    let client = reqwest::Client::builder().redirect(reqwest::redirect::Policy::none())
+        .retry(reqwest::retry::never()).timeout(Duration::from_secs(8))
+        .user_agent("xboks-social/1").build().map_err(|_| "http-client")?;
+    let profile = get(&client,OWN_PROFILE,&auth,"2").send().await.map_err(|_| "profile-request")?;
+    let own = self_xuid(&json_response(profile).await?)?;
+    let mut result = json!({"schema":1,"status":"ready","account":account,"selfXuid":own,
+        "capabilities":{"friends":true,"presence":true,"inbox":true,"conversation":true,"send":true,"search":true,"partyVoice":false}});
+    match command {
+        SocialCommand::Friends => {
+            let response = get(&client,FRIENDS,&auth,"7").send().await.map_err(|_| "friends-request")?;
+            result["friends"] = json!(people(&json_response(response).await?,false)?);
+        },
+        SocialCommand::Search => {
+            let mut url = reqwest::Url::parse(SEARCH).map_err(|_| "search-url")?;
+            url.query_pairs_mut().append_pair("q",&payload.ok_or("stdin-required")?);
+            let response = get(&client,url.as_str(),&auth,"1").send().await.map_err(|_| "search-request")?;
+            result["friends"] = json!(people(&json_response(response).await?,true)?);
+        },
+        SocialCommand::Inbox => {
+            let response = get(&client,&format!("{INBOX}?maxItems=100"),&auth,"1")
+                .send().await.map_err(|_| "inbox-request")?;
+            let v = json_response(response).await?;
+            let (rows, omitted) = inbox(&v,&own)?;
+            result["conversations"] = json!(rows); result["omittedConversations"] = json!(omitted);
+            if let Some(n) = v["primary"]["totalCount"].as_u64() { result["totalCount"] = json!(n); result["hasMore"] = json!(n > v["primary"]["conversations"].as_array().unwrap().len() as u64); }
+        },
+        SocialCommand::Conversation { peer } => {
+            if peer == &own { return Err("conversation-self"); }
+            let url = format!("https://xblmessaging.xboxlive.com/network/Xbox/users/me/conversations/users/xuid({peer})");
+            let response = get(&client,&format!("{url}?maxItems=100"),&auth,"1")
+                .send().await.map_err(|_| "conversation-request")?;
+            let (rows,token) = conversation(&json_response(response).await?,&own,peer)?;
+            result["peerXuid"] = json!(peer); result["messages"] = json!(rows);
+            if let Some(token) = token { result["continuationToken"] = json!(token); }
+        },
+        SocialCommand::Send { peer } => {
+            if peer == &own { return Err("conversation-self"); }
+            let url = format!("https://xblmessaging.xboxlive.com/network/Xbox/users/me/conversations/users/xuid({peer})");
+            account_matches(tokens,&account)?;
+            let request = client.post(url).header("Authorization",&auth).header("x-xbl-contract-version","1")
+                .json(&json!({"parts":[{"contentType":"text","version":0,"text":payload.ok_or("stdin-required")?}]}));
+            result["sent"] = send_once(request).await?; result["peerXuid"] = json!(peer);
+        }
+    }
+    account_matches(tokens,&account)?;
+    Ok(result)
+}
+pub async fn run(tokens: &TokenManager, command: SocialCommand, json_output: bool) -> ExitCode {
+    if !json_output { eprintln!("Xbox social unavailable: json-required"); return ExitCode::FAILURE; }
+    let sending = matches!(command,SocialCommand::Send { .. });
+    let payload = if sending || matches!(command,SocialCommand::Search) {
+        match read_input(sending) { Ok(s) => Some(s), Err(stage) => { eprintln!("Xbox social unavailable: {stage}"); return ExitCode::FAILURE; } }
+    } else { None };
+    match tokio::time::timeout(Duration::from_secs(35),lookup(tokens,&command,payload)).await {
+        Ok(Ok(value)) => { println!("{value}"); ExitCode::SUCCESS },
+        Ok(Err(stage)) => { eprintln!("Xbox social unavailable: {stage}"); ExitCode::FAILURE },
+        Err(_) => { eprintln!("Xbox social unavailable: {}",if sending { "send-delivery-unconfirmed" } else { "request-timeout" }); ExitCode::FAILURE }
+    }
+}
