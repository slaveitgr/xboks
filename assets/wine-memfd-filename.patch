diff --git a/server/fd.c b/server/fd.c
index 69a22e4e27..c9b581313b 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -1927,6 +1927,19 @@ void get_nt_name( struct fd *fd, struct unicode_str *name )
     name->len = fd->nt_namelen;
 }
 
+/* Preserve the logical name when the contents live in an anonymous memfd. */
+int set_fd_nt_name( struct fd *fd, const struct unicode_str *name )
+{
+    WCHAR *copy;
+
+    if (!name->len) return 1;
+    if (!(copy = memdup( name->str, name->len ))) return 0;
+    free( fd->nt_name );
+    fd->nt_name = copy;
+    fd->nt_namelen = name->len;
+    return 1;
+}
+
 /***********************************************************************
  *           get_mapped_exe_file
  */
