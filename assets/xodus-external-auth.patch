+// UI transport only. LoginHandler still performs the original Microsoft token
+// exchange and stores the result in the same keychain. Never log these frames.
+use reqwest::header::{HeaderMap, HeaderValue};
+use serde_json::{Value, json};
+use std::io::{BufRead, Write};
+use std::sync::atomic::{AtomicBool, Ordering};
+use xodus::models::live::{DAProperty, HostBridgeMessage};
+
+type HandlerResult<T> = Result<T, Box<dyn std::error::Error>>;
+const LIMIT: usize = 128 * 1024;
+static ENABLED: AtomicBool = AtomicBool::new(false);
+pub fn enable_stdio() {
+    ENABLED.store(true, Ordering::Release);
+}
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub struct SessionId(u64);
+pub enum HandlerControl<T> {
+    Continue,
+    Complete(T),
+}
+pub trait SessionHandler {
+    type Output: std::fmt::Debug;
+    fn bootstrap(&mut self, runtime: &mut RuntimeCommands) -> HandlerResult<()>;
+    fn on_token(
+        &mut self,
+        session_id: SessionId,
+        data: DAProperty,
+        runtime: &mut RuntimeCommands,
+    ) -> HandlerResult<HandlerControl<Self::Output>>;
+    fn on_closed(
+        &mut self,
+        _: SessionId,
+        _: &mut RuntimeCommands,
+    ) -> HandlerResult<HandlerControl<Self::Output>> {
+        Ok(HandlerControl::Continue)
+    }
+}
+pub struct WebviewRequest {
+    title: String,
+    url: String,
+    headers: HeaderMap,
+}
+enum Action {
+    Open(SessionId, WebviewRequest),
+    Close(SessionId),
+}
+pub struct RuntimeCommands {
+    next: u64,
+    actions: Vec<Action>,
+}
+impl RuntimeCommands {
+    pub fn open_session(&mut self, request: WebviewRequest) -> SessionId {
+        let id = SessionId(self.next);
+        self.next += 1;
+        self.actions.push(Action::Open(id, request));
+        id
+    }
+    pub fn close_session(&mut self, id: SessionId) {
+        self.actions.push(Action::Close(id));
+    }
+}
+pub fn login_request(client_id: String, market: String) -> WebviewRequest {
+    let uid = uuid::Uuid::new_v4();
+    let mut headers = HeaderMap::new();
+    headers.insert("cxh-capabilities",HeaderValue::from_static(r#"{"PrivatePropertyBag":1,"PasswordlessConnect":1,"PreferAssociate":1,"ChromelessUI":0}"#));
+    headers.insert(
+        "cxh-correlationid",
+        HeaderValue::from_str(&uid.to_string()).unwrap(),
+    );
+    headers.insert("cxh-msabinaryversion", HeaderValue::from_static("55"));
+    headers.insert(
+        "cxh-identityclientbinaryversion",
+        HeaderValue::from_static("3"),
+    );
+    headers.insert(
+        "cxh-osversioninfo",
+        HeaderValue::from_static(
+            r#"{"platformId":2,"majorVersion":10,"minorVersion":0,"buildNumber":26100}"#,
+        ),
+    );
+    headers.insert(
+        "cxh-platform",
+        HeaderValue::from_static("CloudExperienceHost.Platform.DESKTOP"),
+    );
+    headers.insert("cxh-protocol", HeaderValue::from_static("TokenBroker"));
+    headers.insert("cxh-source", HeaderValue::from_static("TokenBroker"));
+    headers.insert("hostapp", HeaderValue::from_static("CloudExperienceHost"));
+    WebviewRequest {
+        title: "Xodus sign in".into(),
+        url: format!(
+            "https://login.live.com/ppsecure/InlineLogin.srf?id=80604&scid=3&mkt={market}&Platform=Windows10&clientid={client_id}&hosted=1"
+        ),
+        headers,
+    }
+}
+pub fn finalize_request(url: String) -> WebviewRequest {
+    WebviewRequest {
+        title: "Completing Xodus sign-in".into(),
+        url,
+        headers: HeaderMap::new(),
+    }
+}
+fn emit(out: &mut impl Write, value: Value) -> HandlerResult<()> {
+    let bytes = serde_json::to_vec(&value)?;
+    if bytes.len() > LIMIT {
+        return Err(std::io::Error::other("Sign-in frame too large").into());
+    }
+    out.write_all(b"NEXUS_AUTH_V1 ")?;
+    out.write_all(&bytes)?;
+    out.write_all(b"\n")?;
+    out.flush()?;
+    Ok(())
+}
+fn read_frame(reader: &mut impl BufRead) -> HandlerResult<Value> {
+    let mut data = Vec::new();
+    std::io::Read::take(reader, (LIMIT + 1) as u64).read_until(b'\n', &mut data)?;
+    if data.is_empty() || data.len() > LIMIT || data.last() != Some(&b'\n') {
+        return Err(std::io::Error::other("Sign-in UI disconnected or invalid frame").into());
+    }
+    Ok(serde_json::from_slice(&data)?)
+}
+fn dispatch(
+    commands: &mut RuntimeCommands,
+    active: &mut Option<SessionId>,
+    out: &mut impl Write,
+) -> HandlerResult<()> {
+    for action in commands.actions.drain(..) {
+        match action {
+            Action::Open(id, request) => {
+                let headers: std::collections::BTreeMap<_, _> = request
+                    .headers
+                    .iter()
+                    .map(|(k, v)| (k.as_str(), v.to_str().unwrap_or("")))
+                    .collect();
+                emit(
+                    out,
+                    json!({"type":"open","session":id.0,"title":request.title,"url":request.url,"headers":headers}),
+                )?;
+                *active = Some(id);
+            }
+            Action::Close(id) => {
+                emit(out, json!({"type":"close","session":id.0}))?;
+                if *active == Some(id) {
+                    *active = None;
+                }
+            }
+        }
+    }
+    Ok(())
+}
+pub fn run_sessions<T: SessionHandler>(handler: T) -> HandlerResult<Option<T::Output>> {
+    if !ENABLED.load(Ordering::Acquire) {
+        return Err(std::io::Error::other(
+            "This candidate requires a compatible Nexus external sign-in UI",
+        )
+        .into());
+    }
+    let mut reader = std::io::BufReader::new(std::io::stdin());
+    run_transport(handler, &mut reader, &mut std::io::stdout().lock())
+}
+fn run_transport<T: SessionHandler>(
+    mut handler: T,
+    reader: &mut impl BufRead,
+    out: &mut impl Write,
+) -> HandlerResult<Option<T::Output>> {
+    emit(out, json!({"type":"ready","version":1}))?;
+    let hello = read_frame(reader)?;
+    if hello["type"] != "hello" || hello["version"] != 1 {
+        return Err(std::io::Error::other("Unsupported sign-in UI protocol").into());
+    }
+    let mut commands = RuntimeCommands {
+        next: 1,
+        actions: Vec::new(),
+    };
+    let mut active = None;
+    handler.bootstrap(&mut commands)?;
+    dispatch(&mut commands, &mut active, out)?;
+    loop {
+        let event = read_frame(reader)?;
+        let id = SessionId(event["session"].as_u64().ok_or("Invalid sign-in session")?);
+        if active != Some(id) {
+            continue;
+        }
+        let result = match event["type"].as_str() {
+            Some("closed") => handler.on_closed(id, &mut commands)?,
+            Some("ipc") => {
+                let payload = event["payload"]
+                    .as_str()
+                    .ok_or("Invalid sign-in response")?;
+                if let Ok(data) = serde_json::from_str::<DAProperty>(payload) {
+                    handler.on_token(id, data, &mut commands)?
+                } else if let Ok(message) = serde_json::from_str::<HostBridgeMessage>(payload) {
+                    if let Some(context) = message.get_context_invoke() {
+                        emit(
+                            out,
+                            json!({"type":"context","session":id.0,"context":context}),
+                        )?;
+                    }
+                    HandlerControl::Continue
+                } else {
+                    HandlerControl::Continue
+                }
+            }
+            _ => return Err(std::io::Error::other("Unexpected sign-in UI event").into()),
+        };
+        dispatch(&mut commands, &mut active, out)?;
+        if let HandlerControl::Complete(value) = result {
+            return Ok(Some(value));
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    struct FakeHandler {
+        tokens: usize,
+    }
+    impl SessionHandler for FakeHandler {
+        type Output = usize;
+        fn bootstrap(&mut self, runtime: &mut RuntimeCommands) -> HandlerResult<()> {
+            runtime.open_session(login_request("synthetic".into(), "en-US".into()));
+            Ok(())
+        }
+        fn on_token(
+            &mut self,
+            id: SessionId,
+            _data: DAProperty,
+            runtime: &mut RuntimeCommands,
+        ) -> HandlerResult<HandlerControl<usize>> {
+            self.tokens += 1;
+            runtime.close_session(id);
+            if self.tokens == 1 {
+                runtime.open_session(finalize_request("https://login.live.com/finish".into()));
+                Ok(HandlerControl::Continue)
+            } else {
+                Ok(HandlerControl::Complete(self.tokens))
+            }
+        }
+        fn on_closed(
+            &mut self,
+            id: SessionId,
+            runtime: &mut RuntimeCommands,
+        ) -> HandlerResult<HandlerControl<usize>> {
+            runtime.close_session(id);
+            Ok(HandlerControl::Complete(0))
+        }
+    }
+    fn fixture(events: Vec<Value>) -> (HandlerResult<Option<usize>>, Vec<Value>) {
+        let bytes = events
+            .into_iter()
+            .map(|v| v.to_string() + "\n")
+            .collect::<String>();
+        let mut out = Vec::new();
+        let result = run_transport(
+            FakeHandler { tokens: 0 },
+            &mut std::io::Cursor::new(bytes),
+            &mut out,
+        );
+        let frames = String::from_utf8(out)
+            .unwrap()
+            .lines()
+            .map(|s| serde_json::from_str(s.strip_prefix("NEXUS_AUTH_V1 ").unwrap()).unwrap())
+            .collect();
+        (result, frames)
+    }
+    fn token(id: u64) -> Value {
+        let payload = json!({"sDAToken":"synthetic","sDASessionKey":"synthetic","sDAStartTime":"synthetic","sDAExpires":"synthetic","sSTSInlineFlowToken":"synthetic","sSigninName":"synthetic","K":"synthetic"});
+        json!({"type":"ipc","session":id,"payload":payload.to_string()})
+    }
+    #[test]
+    fn two_step_transport_preserves_context_and_ignores_stale_sessions() {
+        let context = "quoted \"context\" \\ synthetic";
+        let message = json!({"type":"invoke","value":{"name":"CloudExperienceHost.getContext","context":context}});
+        let (result, frames) = fixture(vec![
+            json!({"type":"hello","version":1}),
+            json!({"type":"ipc","session":1,"payload":message.to_string()}),
+            token(1),
+            token(1),
+            token(2),
+        ]);
+        assert_eq!(result.unwrap(), Some(2));
+        assert_eq!(
+            frames
+                .iter()
+                .map(|v| v["type"].as_str().unwrap())
+                .collect::<Vec<_>>(),
+            vec!["ready", "open", "context", "close", "open", "close"]
+        );
+        assert_eq!(frames[2]["context"], context);
+        assert_eq!(frames[4]["session"], 2);
+    }
+    #[test]
+    fn closing_window_completes_without_authentication() {
+        let (result, frames) = fixture(vec![
+            json!({"type":"hello","version":1}),
+            json!({"type":"closed","session":1}),
+        ]);
+        assert_eq!(result.unwrap(), Some(0));
+        assert_eq!(frames.last().unwrap()["type"], "close");
+    }
+    #[test]
+    fn incompatible_handshake_never_opens_window() {
+        let (result, frames) = fixture(vec![json!({"type":"hello","version":2})]);
+        assert!(result.is_err());
+        assert_eq!(frames.len(), 1);
+    }
+    #[test]
+    fn transport_rejects_overlong_and_unterminated_frames() {
+        assert!(read_frame(&mut std::io::Cursor::new(vec![b'x'; LIMIT + 10])).is_err());
+        assert!(read_frame(&mut std::io::Cursor::new(b"{}".as_slice())).is_err());
+        assert!(
+            read_frame(&mut std::io::Cursor::new(
+                b"{\"type\":\"hello\",\"version\":1}\n".as_slice()
+            ))
+            .is_ok()
+        );
+    }
+    #[test]
+    fn original_login_request_headers_and_target_are_preserved() {
+        let request = login_request("client".into(), "en-US".into());
+        assert!(
+            request
+                .url
+                .starts_with("https://login.live.com/ppsecure/InlineLogin.srf?")
+        );
+        assert_eq!(request.headers.len(), 9);
+        assert_eq!(request.headers["hostapp"], "CloudExperienceHost");
+    }
+}
