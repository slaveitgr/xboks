+//! Real installed-package version check; unknown state is never empty success.
+use crate::simple_context::SimpleContext;
+use serde::{Deserialize, Serialize};
+use std::time::Duration;
+use xodus::models::{packagespc::PackageResponse, secrets::Token};
+
+const FAIL: u32 = 0x80004005;
+const INVALID: u32 = 0x80070057;
+const DENIED: u32 = 0x80070005;
+const UNSUPPORTED: u32 = 0x80004001;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "PascalCase")]
+pub struct Request {
+    product_id: String,
+    installed_version: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "PascalCase")]
+pub struct Response {
+    #[serde(rename = "HResult")]
+    hresult: u32,
+    checked: bool,
+    latest_version: String,
+    // Only the genuinely verified no-update case is currently implemented.
+    // Newer packages need authoritative mandatory/DLC policy, not guessing.
+    count: u32,
+    // Sanitized diagnostics only: never authentication material or server bodies.
+    error_stage: &'static str,
+}
+
+struct CheckError {
+    hresult: u32,
+    stage: &'static str,
+    latest_version: String,
+}
+
+impl From<u32> for CheckError {
+    fn from(hresult: u32) -> Self {
+        Self { hresult, stage: "package-query", latest_version: String::new() }
+    }
+}
+
+fn version_error(hresult: u32, stage: &'static str, latest: &str) -> CheckError {
+    let latest_version = if latest.len() <= 80 && latest.bytes().all(|b| b.is_ascii_alphanumeric() || b".,_- ".contains(&b)) {
+        latest.to_owned()
+    } else { String::new() };
+    CheckError { hresult, stage, latest_version }
+}
+
+fn version(text: &str) -> Result<[u16; 4], u32> {
+    let parts: Vec<_> = text.split('.').collect();
+    if parts.len() != 4 { return Err(INVALID); }
+    let mut output = [0; 4];
+    for (slot, part) in output.iter_mut().zip(parts) {
+        if part.is_empty() || !part.bytes().all(|c| c.is_ascii_digit()) { return Err(INVALID); }
+        *slot = part.parse().map_err(|_| INVALID)?;
+    }
+    Ok(output)
+}
+
+fn compare(installed: &str, latest: &str) -> Result<(), u32> {
+    if version(installed)? < version(latest)? { Err(UNSUPPORTED) } else { Ok(()) }
+}
+
+// GetBasePackage returns a package version plus its version-id GUID, unlike
+// MicrosoftGame.config's four-component XVersion. The GUID in Version is NOT
+// the separate download VersionId (confirmed on an actual package response).
+// Accept only the exact four-component + canonical GUID form, not arbitrary
+// trailing text. Compare the numeric version, never the package identity GUID.
+fn package_version(text: &str) -> Result<String, u32> {
+    if version(text).is_ok() { return Ok(text.to_owned()); }
+    let (numeric, suffix) = text.rsplit_once('.').ok_or(INVALID)?;
+    let guid = suffix.len() == 36 && suffix.bytes().enumerate().all(|(i, b)| {
+        if [8, 13, 18, 23].contains(&i) { b == b'-' } else { b.is_ascii_hexdigit() }
+    });
+    if !guid { return Err(INVALID); }
+    version(numeric)?;
+    Ok(numeric.to_owned())
+}
+
+struct AbortOnDrop(tokio::task::AbortHandle);
+impl Drop for AbortOnDrop { fn drop(&mut self) { self.0.abort(); } }
+
+async fn check(context: &SimpleContext, request: Request) -> Result<String, CheckError> {
+    if request.product_id.len() != 12 || !request.product_id.bytes().all(|c| c.is_ascii_alphanumeric()) {
+        return Err(version_error(INVALID, "product-id", ""));
+    }
+    version(&request.installed_version).map_err(|hr| version_error(hr, "installed-version", ""))?;
+    let catalog = xodus::api::displaycatalog::find_products_by_id(
+        &context.client, request.product_id, "neutral".into(), vec!["en".into(), "neutral".into()],
+    ).await.map_err(|_| FAIL)?;
+    let mut content_ids = Vec::new();
+    for availability in catalog.product.display_sku_availabilities {
+        for package in availability.sku.properties.packages {
+            if package.platform_dependencies.iter().any(|dep| dep.platform_name == "Windows.Desktop") {
+                if let Some(id) = package.content_id { content_ids.push(id); }
+            }
+        }
+    }
+    content_ids.sort(); content_ids.dedup();
+    // Never silently choose the first edition/architecture of a bundle.
+    if content_ids.len() != 1 { return Err(UNSUPPORTED.into()); }
+    let id = content_ids.pop().ok_or(FAIL)?;
+    if id.len() != 36 || !id.bytes().all(|c| c.is_ascii_hexdigit() || c == b'-') { return Err(FAIL.into()); }
+    let device = context.device_token.clone().ok_or(DENIED)?;
+    let Token::Legacy(user) = context.tokens().get_user_sts_token().map_err(|_| DENIED)? else { return Err(DENIED.into()); };
+    let client = context.client.clone();
+    // Reuse upstream download authentication, but contain its panic-based errors
+    // in a task so a failed Xbox request cannot terminate this service.
+    let xsts_task = tokio::spawn(async move {
+        xodus::api::xbox::run(&client, device, user, "http://update.xboxlive.com").await
+    });
+    let _cancel_xsts = AbortOnDrop(xsts_task.abort_handle());
+    let xsts = xsts_task.await.map_err(|_| FAIL)?;
+    let response = context.client.get(format!("{}/GetBasePackage/{id}", xodus::XBOX_LIVE_PACKAGES_PC))
+        .header("x-xbl-contract-version", "3")
+        .header("Authorization", xodus::api::xbox::get_xsts_auth_header(xsts))
+        .send().await.map_err(|_| FAIL)?;
+    if response.status().as_u16() == 401 || response.status().as_u16() == 403 { return Err(DENIED.into()); }
+    let mut response = response.error_for_status().map_err(|_| FAIL)?;
+    if response.content_length().is_some_and(|size| size > 8 * 1024 * 1024) { return Err(FAIL.into()); }
+    // Bound chunked responses too; the response contains private license data.
+    let mut body = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| FAIL)? {
+        if body.len() + chunk.len() > 8 * 1024 * 1024 { return Err(FAIL.into()); }
+        body.extend_from_slice(&chunk);
+    }
+    let PackageResponse::Found(package) = serde_json::from_slice(&body).map_err(|_| FAIL)? else { return Err(DENIED.into()); };
+    if !package.package_found || !package.content_id.eq_ignore_ascii_case(&id) { return Err(FAIL.into()); }
+    let latest = package_version(&package.version)
+        .map_err(|hr| version_error(hr, "latest-version", &package.version))?;
+    compare(&request.installed_version, &latest)
+        .map_err(|hr| version_error(hr, "version-comparison", &latest))?;
+    Ok(latest)
+}
+
+pub async fn handle(context: &SimpleContext, body: &[u8]) -> Response {
+    let request = std::str::from_utf8(body).ok().and_then(|text| quick_xml::de::from_str::<Request>(text).ok());
+    let result = match request {
+        Some(request) => tokio::time::timeout(Duration::from_secs(60), check(context, request)).await.unwrap_or(Err(FAIL.into())),
+        None => Err(version_error(INVALID, "request-xml", "")),
+    };
+    match result {
+        Ok(latest_version) => Response { hresult: 0, checked: true, latest_version, count: 0, error_stage: "" },
+        Err(error) => Response { hresult: error.hresult, checked: false, latest_version: error.latest_version, count: 0, error_stage: error.stage },
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn native_request_xml() {
+        let request: Request = quick_xml::de::from_str("<Request><ProductId>9ABCDEFGHIJK</ProductId><InstalledVersion>1.1.2.0</InstalledVersion></Request>").unwrap();
+        assert_eq!(request.product_id, "9ABCDEFGHIJK");
+        assert_eq!(request.installed_version, "1.1.2.0");
+    }
+    #[test] fn exact_versions() { assert_eq!(version("1.2.3.4"), Ok([1,2,3,4])); }
+    #[test] fn authoritative_compound_version() {
+        let id = "01234567-89ab-cdef-0123-456789abcdef";
+        assert_eq!(package_version(&format!("1.1.2.0.{id}")), Ok("1.1.2.0".into()));
+        assert!(package_version("1.1.2.0.unknown").is_err());
+        assert!(package_version("1.1.2.0.01234567_89ab-cdef-0123-456789abcdef").is_err());
+    }
+    #[test] fn malformed_versions_fail() { for v in ["1.2", "1.2.3.-1", "1.2.3.65536", "1.2.3.", "1.2.3. 4"] { assert!(version(v).is_err()); } }
+    #[test] fn equal_and_newer_installed() { assert_eq!(compare("1.2.3.4", "1.2.3.4"), Ok(())); assert_eq!(compare("1.2.4.0", "1.2.3.9"), Ok(())); }
+    #[test] fn outdated_is_not_empty_success() { assert_eq!(compare("1.2.3.4", "1.2.4.0"), Err(UNSUPPORTED)); }
+    #[test] fn unknown_latest_fails() { assert!(compare("1.2.3.4", "unknown").is_err()); }
+    #[test] fn wire_hresult_and_verification() {
+        let response = Response { hresult: FAIL, checked: false, latest_version: String::new(), count: 0, error_stage: "package-query" };
+        let xml = quick_xml::se::to_string(&response).unwrap();
+        assert!(xml.contains("<HResult>2147500037</HResult>"));
+        assert!(xml.contains("<Checked>false</Checked>"));
+    }
+}
