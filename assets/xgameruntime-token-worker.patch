+static DWORD WINAPI token_signature_worker_thread( void *arg )
+{
+    struct token_signature_worker *worker = arg;
+    struct XUserGetTokenAndSignatureContext *context = worker->data.context;
+    HRESULT hr, com = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    if (InterlockedCompareExchange( &context->canceled, 0, 0 )) hr = E_ABORT;
