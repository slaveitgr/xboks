+static HRESULT WINAPI XUserGetTokenAndSignatureProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    struct XUserGetTokenAndSignatureContext *context = data->context;
+    struct token_signature_worker *worker;
+    HANDLE thread;
+    HRESULT hr;
+    if (op != XAsyncOp_DoWork) return token_signature_phase( op, data );
