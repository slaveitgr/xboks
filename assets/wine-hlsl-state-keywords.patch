index 85f0d89a..27ef9fa4 100644
--- a/libs/vkd3d-shader/hlsl.l
+++ b/libs/vkd3d-shader/hlsl.l
@@ -35,6 +35,16 @@ static void update_location(struct hlsl_ctx *ctx, YYLTYPE *loc);
 
 static void apply_escape_sequences(char *str);
 
+static int stateblock_keyword(struct hlsl_ctx *ctx, YYSTYPE *value, const char *name, int token)
+{
+    /* State enumerants are case-insensitive, even when their lowercase
+     * spelling is an HLSL interpolation or geometry keyword. */
+    if (!ctx->in_state_block)
+        return token;
+    value->name = hlsl_strdup(ctx, name);
+    return NEW_IDENTIFIER;
+}
+
 #define YY_USER_ACTION update_location(yyget_extra(yyscanner), yyget_lloc(yyscanner));
 
