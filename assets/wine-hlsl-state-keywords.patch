 matrix                  {return KW_MATRIX;              }
 namespace               {return KW_NAMESPACE;           }
 nointerpolation         {return KW_NOINTERPOLATION;     }
@@ -124,7 +134,7 @@ pass                    {return KW_PASS;                }
 PixelShader             {return KW_PIXELSHADER;         }
