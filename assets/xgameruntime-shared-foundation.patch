+            }
+            if (SUCCEEDED(hr = http_request_raw( methodW, urlW, headersW, body, bodySize, status, buffer, bufferSize )) && *status < 500) break;
+            if (SUCCEEDED(hr))
+            {
+                free( *buffer );
+                *buffer = NULL;
+                *bufferSize = 0;
+            }
+        }
+    }
+
+    free( methodW );
+    free( urlW );
+    free( headersW );
+    free( headers );
+    return hr;
+}
