+fn optional_profile_text(value: &str, limit: usize, multiline: bool) -> Option<&str> {
+    if value.len() > limit || value.chars().any(|c| c.is_control() && !(multiline && ['\n', '\r', '\t'].contains(&c))) { return None; }
+    let value = value.trim();
+    (!value.is_empty()).then_some(value)
+}
