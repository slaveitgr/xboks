+// The settings returned by this self-profile request are the only source of
+// these fields. Do not serialize raw provider objects, IDs or inferred totals.
+fn profile_details(value: &Value) -> Value {
+    let mut result = json!({});
+    let Some(users) = value["profileUsers"].as_array().filter(|users| users.len() == 1) else { return result; };
+    let Some(settings) = users[0]["settings"].as_array().filter(|settings| settings.len() <= 64) else { return result; };
+    let setting = |name: &str| settings.iter().find(|item| item["id"] == name).and_then(|item| item["value"].as_str());
+    for (source, target, limit, multiline) in [
+        ("Bio", "bio", 4096, true), ("Location", "location", 256, false), ("RealName", "realName", 256, false),
+        ("GameDisplayName", "gameDisplayName", 256, false), ("AppDisplayName", "appDisplayName", 256, false),
+        ("AccountTier", "accountTier", 64, false), ("ModernGamertag", "modernGamertag", 256, false),
+        ("UniqueModernGamertag", "uniqueModernGamertag", 256, false),
+    ] {
+        if let Some(text) = setting(source).and_then(|value| optional_profile_text(value, limit, multiline)) { result[target] = json!(text); }
+    }
+    for (source, target) in [("Gamerscore", "gamerscore"), ("TenureLevel", "tenureLevel")] {
+        if let Some(number) = setting(source).filter(|text| !text.is_empty() && text.len() <= 10 && text.bytes().all(|c| c.is_ascii_digit()))
+            .and_then(|text| text.parse::<u32>().ok()) { result[target] = json!(number); }
+    }
+    if let Some(suffix) = setting("ModernGamertagSuffix").filter(|text| !text.is_empty() && text.len() <= 16 && text.bytes().all(|c| c.is_ascii_digit())) {
+        result["modernGamertagSuffix"] = json!(suffix);
+    }
+    result
 }
 
