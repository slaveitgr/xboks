+    #[test]
+    fn profile_details_only_exposes_bounded_provider_fields_including_actual_zero_score() {
+        let value = json!({"profileUsers":[{"id":"private-id", "settings":[
+            {"id":"Gamerscore","value":"0"}, {"id":"TenureLevel","value":"7"},
+            {"id":"Bio","value":"First line\nSecond line"}, {"id":"Location","value":"Example location"},
+            {"id":"RealName","value":"Example Name"}, {"id":"ModernGamertag","value":"Example"},
+            {"id":"UniqueModernGamertag","value":"Example#1234"}, {"id":"ModernGamertagSuffix","value":"1234"},
+            {"id":"AccountTier","value":"Gold"}, {"id":"UnknownField","value":"private-value"}]}]});
+        let details = profile_details(&value);
+        assert_eq!(details["gamerscore"], 0); assert_eq!(details["tenureLevel"], 7);
+        assert_eq!(details["bio"], "First line\nSecond line"); assert_eq!(details["location"], "Example location");
+        assert_eq!(details["realName"], "Example Name"); assert_eq!(details["modernGamertagSuffix"], "1234");
