+struct task_callback_entry
+{
+    void *context;
+    XTaskQueueCallback *callback;
+    struct task_callback_entry *next;
+};
+
+struct task_queue
+{
+    XTaskQueueDispatchMode work_mode;
+    XTaskQueueDispatchMode completion_mode;
+    LONG ref;
+    volatile LONG init_state;
+    BOOL terminated;
+    CRITICAL_SECTION cs;
+    HANDLE work_event;
+    HANDLE completion_event;
+    struct task_callback_entry *work_head;
+    struct task_callback_entry *work_tail;
+    struct task_callback_entry *completion_head;
+    struct task_callback_entry *completion_tail;
+};
+
+struct threadpool_task
+{
+    void *context;
+    XTaskQueueCallback *callback;
+    UINT32 delay_ms;
+};
+
+struct termination_task
+{
+    void *context;
+    XTaskQueueTerminatedCallback *callback;
+};
+
+static struct task_queue default_process_queue =
+{
+    XTaskQueueDispatchMode_ThreadPool,
+    XTaskQueueDispatchMode_ThreadPool,
+    1,
+};
+static XTaskQueueHandle current_process_queue = (XTaskQueueHandle)&default_process_queue;
+
+static void init_task_queue( struct task_queue *queue )
+{
+    LONG state;
+
+    if (InterlockedCompareExchange( &queue->init_state, 1, 0 ) == 0)
+    {
+        InitializeCriticalSection( &queue->cs );
+        queue->work_event = CreateEventW( NULL, FALSE, FALSE, NULL );
+        queue->completion_event = CreateEventW( NULL, FALSE, FALSE, NULL );
+        InterlockedExchange( &queue->init_state, 2 );
+        return;
+    }
+
+    while ((state = InterlockedCompareExchange( &queue->init_state, 2, 2 )) != 2) Sleep( 0 );
+}
+
+static DWORD WINAPI threadpool_task_proc( void *parameter )
+{
+    struct threadpool_task *task = parameter;
+
+    if (task->delay_ms) Sleep( task->delay_ms );
+    if (task->callback) task->callback( task->context, FALSE );
+    free( task );
+    return 0;
+}
+
+static void WINAPI async_completion_thunk( void *context, BOOLEAN canceled )
+{
+    XAsyncBlock *async = context;
+
+    if (!canceled && async && async->callback) async->callback( async );
+}
+
+static void WINAPI termination_thunk( void *context, BOOLEAN canceled )
+{
+    struct termination_task *task = context;
+
+    if (!canceled && task->callback) task->callback( task->context );
+    free( task );
+}
+
+static HRESULT submit_callback( struct task_queue *queue, XTaskQueuePort port,
+                                void *context, XTaskQueueCallback *callback, BOOL allow_terminated )
+{
+    struct task_callback_entry *entry;
+    struct task_callback_entry **head, **tail;
+    HANDLE event;
+
+    if (!callback) return S_OK;
+    init_task_queue( queue );
+
+    entry = malloc( sizeof(*entry) );
+    if (!entry) return E_OUTOFMEMORY;
+    entry->context = context;
+    entry->callback = callback;
+    entry->next = NULL;
+
+    EnterCriticalSection( &queue->cs );
+    if (queue->terminated && !allow_terminated)
+    {
+        LeaveCriticalSection( &queue->cs );
+        free( entry );
+        return E_ABORT;
+    }
+
+    if (port == XTaskQueuePort_Work)
+    {
+        head = &queue->work_head;
+        tail = &queue->work_tail;
+        event = queue->work_event;
+    }
+    else
+    {
+        head = &queue->completion_head;
+        tail = &queue->completion_tail;
+        event = queue->completion_event;
+    }
+    if (*tail) (*tail)->next = entry;
+    else *head = entry;
+    *tail = entry;
+    LeaveCriticalSection( &queue->cs );
+    SetEvent( event );
+    return S_OK;
+}
+
