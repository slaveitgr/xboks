+//! Private stdout-only cloud SSO exchange. No login, device provisioning or credential writes.
+use std::{process::ExitCode, time::Duration};
+use serde_json::{Value, json};
+use xodus::tokens::TokenManager;
+
+const CLOUD_RELYING_PARTY: &str = "http://gssv.xboxlive.com/";
+async fn credential(tokens: &TokenManager) -> Result<Value, &'static str> {
+    let (account, device, user) = super::profile::readonly_credentials(tokens)?;
+    let client = reqwest::Client::builder().redirect(reqwest::redirect::Policy::none())
+        .retry(reqwest::retry::never()).timeout(super::session::REQUEST_TIMEOUT)
+        .user_agent("XBOKS-cloud-session/1").build().map_err(|_| "http-client")?;
+    let (_, ticket, account) = super::profile::bearer_session_for_party(client, account, device, user, CLOUD_RELYING_PARTY).await?;
+    if tokens.get_user().map_err(|_| "account-changed")?.username != account { return Err("account-changed"); }
+    if ticket.token.is_empty() || ticket.token.len() > 100_000 || ticket.token.chars().any(char::is_control)
+        || ticket.not_after < chrono::Utc::now() + chrono::Duration::seconds(30) { return Err("cloud-ticket-invalid"); }
+    Ok(json!({"schema":1,"account":account,"token":ticket.token,"expiresAt":ticket.not_after.to_rfc3339_opts(chrono::SecondsFormat::Millis,true)}))
+}
+
+pub async fn run(tokens: &TokenManager) -> ExitCode {
+    match tokio::time::timeout(Duration::from_secs(45), credential(tokens)).await {
+        Ok(Ok(value)) => { println!("{value}"); ExitCode::SUCCESS },
+        Ok(Err(_)) => { eprintln!("XBOKS cloud account exchange is unavailable; refresh your account in Settings."); ExitCode::FAILURE },
+        Err(_) => { eprintln!("XBOKS cloud account exchange timed out; stored account is unchanged."); ExitCode::FAILURE },
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn cloud_credential_has_a_distinct_service_relying_party() {
+        assert_eq!(CLOUD_RELYING_PARTY, "http://gssv.xboxlive.com/");
+        assert_ne!(CLOUD_RELYING_PARTY, "http://xboxlive.com");
+    }
+    #[test]
+    fn cloud_entry_never_writes_credentials_or_provisions_a_device() {
+        let source = include_str!("cloud.rs");
+        let entry = source.split("#[cfg(test)]").next().unwrap();
+        assert!(!entry.contains("with_keychain_and_memory"));
+        assert!(!entry.contains("ensure_device_credentials"));
+        assert!(!entry.contains(".save("));
+    }
+}
