+
+static DWORD WINAPI gamer_picture_worker_thread( void *arg )
+{
+    struct gamer_picture_worker *worker = arg;
+    struct XUserGetGamerPictureContext *context = worker->data.context;
+    HRESULT hr, com = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    hr = InterlockedCompareExchange( &context->canceled, 0, 0 ) ? E_ABORT :
+        gamer_picture_phase( XAsyncOp_DoWork, &worker->data );
+    if (FAILED(hr)) IXThreadingImpl_XAsyncComplete( worker->threading, worker->data.async, hr, 0 );
+    if (SUCCEEDED(com)) CoUninitialize();
+    gamer_picture_release( context );
+    IXThreadingImpl_Release( worker->threading );
+    free( worker );
+    return 0;
+}
+
+static HRESULT WINAPI XUserGetGamerPictureProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    struct XUserGetGamerPictureContext *context = data->context;
+    struct gamer_picture_worker *worker;
+    HANDLE thread;
+    HRESULT hr;
+    if (op != XAsyncOp_DoWork) return gamer_picture_phase( op, data );
+    if (!(worker = calloc( 1, sizeof(*worker) ))) return E_OUTOFMEMORY;
+    worker->data = *data;
+    if (FAILED(hr = QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&worker->threading )))
+    { free( worker ); return hr; }
+    InterlockedIncrement( &context->refs );
+    if (!(thread = CreateThread( NULL, 0, gamer_picture_worker_thread, worker, 0, NULL )))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        gamer_picture_release( context );
+        IXThreadingImpl_Release( worker->threading );
+        free( worker );
+        return hr;
+    }
+    CloseHandle( thread );
+    return E_PENDING;
+}
